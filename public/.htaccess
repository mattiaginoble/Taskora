# Taskora su Apache/Aruba.
# L'app usa indirizzi con # (es. index.html#/attivita), quindi funziona anche
# dentro una sottocartella senza regole di riscrittura per le sue pagine.

# Indirizzi della versione precedente (segnalibri, pagine rimaste nella cache
# del browser): portano alla pagina corrispondente della nuova app. Se il
# server ignora queste regole, lo fanno le pagine omonime in questa cartella.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^(.*/)(dashboard-inprogress|home)\.html$
  RewriteRule ^ %1#/dashboard [R=302,NE,L]
  RewriteCond %{REQUEST_URI} ^(.*/)todolist\.html$
  RewriteRule ^ %1#/attivita [R=302,NE,L]
  RewriteCond %{REQUEST_URI} ^(.*/)(riepilogo|gestione)\.html$
  RewriteRule ^ %1#/%2 [R=302,NE,L]
</IfModule>

# Pagine HTML sempre aggiornate; i file con l'hash nel nome possono restare in cache
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Credenziali e file interni non raggiungibili dal browser
<FilesMatch "^(config\.local\.php|config\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 404 ^(.*/)?storage/
